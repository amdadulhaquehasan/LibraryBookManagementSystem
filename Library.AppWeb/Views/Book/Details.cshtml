@model Library.Domain.Entity.Book

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4><i class="fa fa-eye"></i> Book Details</h4>
        </div>
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">ISBN</dt>
                <dd class="col-sm-9">@Model.ISBN</dd>

                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@Model.Genre</dd>

                <dt class="col-sm-3">Publication Year</dt>
                <dd class="col-sm-9">@Model.PublicationYear</dd>

                <dt class="col-sm-3">Pages</dt>
                <dd class="col-sm-9">@Model.Pages</dd>

                <dt class="col-sm-3">Available</dt>
                <dd class="col-sm-9">
                    @(Model.IsAvailable ? "Yes" : "No")
                </dd>
            </dl>

            <div class="text-end">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-warning">Edit</a>
                <a asp-action="Index"
                   class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>