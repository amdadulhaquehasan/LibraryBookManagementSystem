@model IEnumerable<Library.Domain.Entity.Book>

@{
    ViewData["Title"] = "Book Catalog";
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary">
        <i class="fa fa-book"></i> Library Book Catalog
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="card card-body mb-4 shadow-sm">
        <div class="row">
            <div class="col-md-5">
                <input type="text" name="searchTerm" class="form-control"
                       placeholder="Search by Title or ISBN" />
            </div>

            <div class="col-md-4">
                <select name="genre" class="form-select">
                    <option value="">All Genres</option>
                    @{
                        var genreProp = typeof(Library.Domain.Entity.Book).GetProperty("Genre");
                        var genreType = genreProp?.PropertyType;
                        if (genreType != null && genreType.IsEnum)
                        {
                            foreach (var val in Enum.GetValues(genreType))
                            {
                                <option value="@val">@val</option>
                            }
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <button class="btn btn-primary w-100">
                    <i class="fa fa-search"></i> Search
                </button>
            </div>
        </div>
    </form>

    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-success">
            <i class="fa fa-plus"></i> Add New Book
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>ISBN</th>
                        <th>Genre</th>
                        <th>Year</th>
                        <th>Pages</th>
                        <th>Available</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.ISBN</td>
                            <td>@book.Genre</td>
                            <td>@book.PublicationYear</td>
                            <td>@book.Pages</td>
                            <td>
                                @if (book.IsAvailable)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@book.Id"
                                   class="btn btn-info btn-sm">
                                    <i class="fa fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@book.Id"
                                   class="btn btn-warning btn-sm">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@book.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this book?');">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
